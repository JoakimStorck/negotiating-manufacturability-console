{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "am-order/runs-1",
  "title": "The frame's runs",
  "description": "What the standing frame serves as its catalogue: every run it holds, from an order or from a scenario, running, parked or done, each as `events-1` names a run and with what the catalogue shows beside it (the decision makers, the last sequence number of its events). Each run carries its `result` once it has ended or parked, so that the catalogue shows what a run came to (the plan's time, material and mass) without reading its events. The tool groups the runs by order or by experiment; a run's events are fetched by its id. An order placed and not yet made a run is presence's (`presence-1`, a run `placed`), not the catalogue's. A sketch of 2026-11-08, written before the frame is built (am-llm's design document 2.6).",
  "type": "object",
  "required": ["schema", "at", "runs"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "runs/1"},
    "at": {"$ref": "#/$defs/time", "description": "When the frame served the document"},
    "runs": {"type": "array", "items": {"$ref": "#/$defs/run"}, "description": "Newest first"}
  },
  "$defs": {
    "time": {"type": "string", "format": "date-time", "pattern": "Z$", "description": "ISO 8601 UTC, on the frame's clock"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "role": {
      "enum": [
        "requester",
        "design_engineer",
        "process_planner",
        "production_planner",
        "quality_engineer",
        "machine_operator",
        "maintenance_technician"
      ]
    },
    "maker": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {"kind": {"enum": ["model", "scripted", "operator", "none"]}, "name": {"type": ["string", "null"]}}
    },
    "result": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/result_outcome"}],
      "description": "The run's result: null while it runs; once it has ended or parked, what it came to. The frame computes it from the run's measures (`measures.json`) once, when the run ends or parks, and never changes it; a parked run has no measures yet, and its `waits` come from the dialogue. Every number carries its unit."
    },
    "result_outcome": {
      "type": "object",
      "required": ["outcome", "reason", "plan", "requirements", "waits", "showing"],
      "additionalProperties": false,
      "properties": {
        "outcome": {"enum": ["accepted", "declined", "parked", "referred", "stopped", "error"]},
        "reason": {
          "type": ["string", "null"],
          "description": "Why it ended so, in words: the requester's reason for declining, the referral's, the error's"
        },
        "plan": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/result_plan"}],
          "description": "The accepted plan, for an accepted run; null otherwise"
        },
        "requirements": {
          "type": "array",
          "items": {"$ref": "#/$defs/result_requirement"},
          "description": "The requirements as finally stated, for an accepted run; empty otherwise"
        },
        "waits": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/result_waits"}],
          "description": "What waits for whom, for a parked run; null otherwise"
        },
        "showing": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/result_showing"}],
          "description": "The last showing, for a declined or referred run, where there was one"
        }
      }
    },
    "result_plan": {
      "type": "object",
      "required": ["id", "design", "orientation", "settings", "print_time_s", "material_g", "verdict", "findings"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "design": {"type": "string"},
        "orientation": {"type": ["string", "null"]},
        "material": {"type": ["string", "null"]},
        "settings": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/result_quantity"},
          "description": "The plan's decision values by name, each with its unit (layer_height in mm, perimeters a count, fill_density in %)"
        },
        "print_time_s": {"type": "number", "minimum": 0, "description": "Print time in s"},
        "material_g": {"type": "number", "minimum": 0, "description": "Material used in g"},
        "mass_g": {"type": ["number", "null"], "minimum": 0, "description": "The printed part's mass in g, where the analysis gives it"},
        "verdict": {"enum": ["ok", "at_risk", "critical", "incomplete"]},
        "findings": {
          "type": "array",
          "items": {"$ref": "#/$defs/finding"},
          "description": "The findings not ok against the requirements as finally stated"
        }
      }
    },
    "result_requirement": {
      "type": "object",
      "required": ["requirement", "kind", "value"],
      "additionalProperties": false,
      "properties": {
        "requirement": {"type": "string", "description": "The case's requirement as the record numbers it"},
        "metric": {"type": ["string", "null"], "description": "The order's metric it carries, where the order gave one"},
        "kind": {"type": "string"},
        "feature": {"type": ["string", "null"]},
        "value": {"type": "object", "description": "The value in force, in the record's form (at_most, at_least, band, equals, holds)"},
        "margin": {"type": ["number", "null"], "description": "The margin in force where the order demands a reserve"},
        "unit": {"type": ["string", "null"]},
        "relaxed": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/result_relaxed"}], "description": "Where it was relaxed in the run"}
      }
    },
    "result_relaxed": {
      "type": "object",
      "required": ["what", "from", "to", "by", "showing"],
      "additionalProperties": false,
      "properties": {
        "what": {"enum": ["margin", "value"]},
        "from": {},
        "to": {},
        "by": {
          "type": "object",
          "required": ["role", "actor"],
          "additionalProperties": false,
          "properties": {
            "role": {
              "enum": [
                "requester",
                "design_engineer",
                "process_planner",
                "production_planner",
                "quality_engineer",
                "machine_operator",
                "maintenance_technician"
              ]
            },
            "actor": {"enum": ["agent", "operator", "owner"]}
          }
        },
        "showing": {
          "type": ["string", "null"],
          "description": "The dialogue's call of the showing the relaxation was made on, where there was one"
        },
        "within_mandate": {"type": ["boolean", "null"]}
      }
    },
    "result_waits": {
      "type": "object",
      "required": ["what", "for", "since", "metrics"],
      "additionalProperties": false,
      "properties": {
        "what": {"enum": ["showing", "question"]},
        "for": {"enum": ["owner", "requester"]},
        "since": {"type": "string", "format": "date-time", "pattern": "Z$"},
        "metrics": {"type": "array", "items": {"type": "string"}},
        "dialogue": {"type": ["string", "null"]}
      }
    },
    "result_showing": {
      "type": "object",
      "required": ["dialogue", "design"],
      "additionalProperties": false,
      "properties": {
        "dialogue": {"type": "string"},
        "design": {"type": ["string", "null"]},
        "plan": {"type": ["string", "null"]},
        "text": {"type": ["string", "null"]}
      }
    },
    "result_quantity": {
      "type": "object",
      "required": ["value", "unit"],
      "additionalProperties": false,
      "properties": {"value": {"type": ["number", "string", "boolean"]}, "unit": {"type": "string"}}
    },
    "finding": {
      "type": "object",
      "required": ["requirement", "status"],
      "additionalProperties": false,
      "properties": {
        "requirement": {"type": "string"},
        "metric": {"type": ["string", "null"]},
        "feature": {"type": ["string", "null"]},
        "status": {"enum": ["at_risk", "critical", "no_data"]},
        "value": {"type": ["number", "null"]},
        "limit": {"type": ["number", "null"]},
        "margin": {"type": ["number", "null"]},
        "unit": {"type": ["string", "null"]},
        "call": {"type": ["string", "null"]}
      }
    },
    "run": {
      "type": "object",
      "required": ["id", "status", "started", "makers", "last"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "The run's name, as `events-1` and the events' address use it: `<lineage>@<revision>` for an order, `<experiment>/<condition>-<nn>` for a scenario's repetition, as its folder is named"
        },
        "order": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["lineage", "revision", "sha256"],
              "additionalProperties": false,
              "properties": {"lineage": {"type": "string"}, "revision": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha"}}
            }
          ]
        },
        "scenario": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["experiment", "condition"],
              "additionalProperties": false,
              "properties": {"experiment": {"type": "string"}, "condition": {"type": "string"}}
            }
          ]
        },
        "lineages": {"type": "array", "items": {"type": "string"}},
        "settings": {"type": "object", "description": "The run's settings as the frame holds them (negotiation, held, ...)"},
        "version": {"type": "string", "description": "am-llm's commit the run ran on"},
        "makers": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/role"},
          "additionalProperties": {"$ref": "#/$defs/maker"},
          "description": "The decision maker that filled each role in the run, the latest where it changed"
        },
        "status": {"enum": ["running", "parked", "done"]},
        "started": {"$ref": "#/$defs/time"},
        "ended": {"oneOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]},
        "outcome": {"type": ["string", "null"]},
        "reason": {"type": ["string", "null"]},
        "result": {"$ref": "#/$defs/result"},
        "last": {
          "type": "integer",
          "minimum": 0,
          "description": "The last sequence number of the run's events: a reader that has read up to it has nothing new to ask for"
        }
      }
    }
  },
