 "brief": {
  "may_change": [
   "lug_thickness",
   "fillet_radius",
   "underside_angle",
   "shape"
  ],
  "may_relax": [],
  "objective": "time",
  "quantity": 10,
  "text": "A bracket that carries a hanging load from a pin to a flat mounting face bolted to a frame. It is loaded in four ways during handling, each for a short time. It is printed in PLA in a small series on the printers available. The mounting face must sit flat against the frame and the bolt holes must meet the frame's pattern. The bracket goes on a frame that moves, where every gram counts: as printed it may weigh no more than the mass requirement of the design says, with every other requirement as first given. Its shape is free within the envelope, the interfaces kept; print time is the objective once the requirements are met."
 },
 "design": "bracket-mass@v1",
 "group": "G2",
 "headings": {
  "assembly": "The interfaces to the frame stand under Geometry; the part is fitted with standard fasteners.",
  "costs": "The time and the material per part stand under Production; nothing else is asked.",
  "energy": "Nothing applies: the part takes no energy and serves at room temperature.",
  "ergonomics": "Nothing applies: the part is fitted once and not handled in use.",
  "kinematics": "Nothing applies: the part has no moving parts and moves only with the frame it is fixed to.",
  "maintenance": "Nothing applies: the part needs no servicing.",
  "operation": "Nothing applies beyond the loads under Forces.",
  "quality_control": "Every demand names how it is verified; the inspection plan is cases/bracket-ge/README.md, its section on inspection.",
  "recycling": "Nothing applies beyond the material under Material.",
  "safety": "Nothing applies beyond the loads it carries, which stand under Forces.",
  "schedules": "Nothing applies: the order is not bound to a date.",
  "signals": "Nothing applies: the part carries no signals and shows nothing.",
  "transport": "Nothing applies: the part is small and light enough for any parcel."
 },
